*~

searxng-docker.service
srv
searxng/uwsgi.ini

# --- Environment Secrets ---
# These contain your SEARXNG_SECRET and hostnames. NEVER commit these.
share/env/.env.secrets
share/env/.env.core
share/env/.env.dynamic
# Prevent committing individual specialized hardware tuning files
#share/model-configs/llama-cpp-configs/
#share/model-configs/ollama-configs/
#!share/model-configs/llama-cpp-configs/presets/*
#!share/model-configs/ollama-configs/presets/*
# Local yaml
.compose.yaml

# --- Docker Runtime Data (Bind Mounts) ---
# These folders are created/populated on startup and can be massive (GBs).
ollama/
models/
open-webui/
caddy/
config/
data/
archive/
plugins/

# --- SearXNG ---
# Ignore everything generated in this folder
searxng/*

# DO NOT ignore these specific files/folders:
!searxng/settings.yml
!searxng/limiter.toml
# NOTE: DO IGNORE searxng/secrets.yml if you change it in a  way that can't be made public.

# Common temp files
*.swp
*.swo
*#
.DS_Store
Thumbs.db

# Python/Node/etc if applicable
__pycache__/
*.pyc
node_modules/

# --- Specific Configs (Optional) ---
# If you want to provide default configs but allow users to change them:
# 1. Commit 'Caddyfile' because it's usually static.
# 2. If you want to keep the FOLDER structure but not the data:
# !ollama/.gitkeep
# !open-webui/.gitkeep
# !searxng/.gitkeep

