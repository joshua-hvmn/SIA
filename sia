## Detect outdated Docker Compose and change commands if necessary

if ! docker compose version >/dev/null 2>&1 && command -v docker-compose >/dev/null 2>&1; then
    docker() { if [[ "$1" == "compose" ]]; then shift; command docker-compose "$@"; else command docker "$@"; fi; }
fi

## Help :
#  - Accepts one extra argument
#  - Add help menus for new commands by adding them to the case statement

printUsage () {
    local arg="${1:-}"
    case "$arg" in
        down|-d|--down)
            cat << EOF
Usage: $scriptName -d <command>

Command being run: docker compose down <command>

Commands:
    (no argument)       None, leaves volumes and app images (default).
    --volumes | -v      Remove volumes named in the compose file.
    --remove-orphans    Remove containers for services no longer in the compose (i.e. you modify it).
    --rmi               Remove images used by services.
    --help | -h         Show the inbuilt Docker help message (not this one).

Pass additional arguments to pass them to the underlying docker command.

EOF
            ;;
        logs|-l|--logs)
            cat << EOF
Usage: $scriptName -l <command>

Command being run: docker compose logs <command>

Commands:
    (no argument)     "--tail 100" shows last 100 logs by default
    <container name>  View logs for that container.
    --timestamps | -t Show timestamps for each file.
    --no-color        Black and white.
    --no-log-prefix   Omit service name/container from each log line.
    help | -h         Show the inbuilt Docker help message (not this one).

Pass additional arguments to pass them to the underlying docker command.

EOF
            ;;
        *)
            cat << EOF
Usage: $scriptName <command>

Commands:
    (no argument)    Start or restart the $appName stack (default)
    setup | -s       Run or rerun the setup wizard to change the setup
    down | -d        Stop the $appName stack. Accepts an additional argument. (Docker command)
    logs | -l        View relevant logs Accepts an additional argument. (Docker command)
    download | -dl   Download an Ollama model. Requires an additional argument. (Docker command)
    help | -h        Show this help message

Pass additional arguments to pass them to the underlying docker command.

Examples:
    $scriptName                 Starts the containers. On first start, runs setup and generates the secret key.
    $scriptName setup           Runs setup, for changing which setup you're using.
    $scriptName -d              Stops all $appName containers.
    $scriptName --help          Shows the help message.
    $scriptName -l --verbose    Shows the logs and passes the --verbose argument.
EOF
            ;;
    esac
}

## Error Exit
#  - Call with the number of you error code in place of "exit #"
#  - Extend by adding to the case statement

errExit () {
    local errorCode="${1:-99}"
    local errorDesc
    case $errorCode in # Don't use code 99
        1)
            errorDesc="usage"
            ;;
        2)
            errorDesc="configuration"
            ;;
        *)
            errorDesc="internal error code"
            errorCode=99
            ;;
    esac
    echo "Exiting with code $errorCode: improper $errorDesc!" >&2
    exit $errorCode
}

## Check Arrays
#  - Add more dependencies in the dependencies array.
#  - Add more environment variables in the envVars array.
#  - Add additional cases to handle new arrays.
#  - Pass the name of the array you want to check.

checkArray () {
    local arrayName="${1:-dependencies}"
    local arrayRef="${arrayName}[@]"
    case $arrayName in
        dependencies)
            for cmd in "${!arrayRef}"; do
                if ! command -v "$cmd" >/dev/null 2>&1; then
                    echo "Error: $cmd not found. Please make sure it is installed and you have permission to use it."
                    errExit 2
                fi
            done
            ;;
        envVars)
            for entry in "${!arrayRef}"; do
                if [[ "$entry" =~ ^# ]]; then
                    # Comment: check for the exact string
                    if ! grep -qF "$entry" "$envFile" 2>/dev/null; then
                        # Append the comment directly
                        [[ -s "$envFile" && -n "$(tail -c 1 "$envFile" 2>/dev/null)" ]] && echo "" >> "$envFile"
                        echo "$entry" >> "$envFile"
                    fi
                else
                    # Variable: extract key and use editEnv logic
                    local key="${entry%%=*}"
                    if ! grep -q "^$key=" "$envFile" 2>/dev/null; then
                        if [[ "$entry" == *"="* ]]; then
                            editEnv "$entry"
                        fi
                    fi
                fi
            done
            ;;
        *)
            echo "ERROR UNKNOWN"
            errExit 1
        ;;
    esac
}

## .env editor
#  - Pass "KEY=VALUE" to update the VALUE or append if missing.
#  - Pass "VALUE" to just write it to the .env
#  - Ensures new line and creates an .env if necessary

editEnv () {
    local entry="$1"
    local key="${entry%%=*}" # Extracts everything before the '='
    local envFileLocal="$envFile"
    local emptyEnv=0

    # Create .env if it doesn't exist
    touch "$envFileLocal"

    # Check if already in the file
    if grep -q "^${entry}$" "$envFileLocal" 2>/dev/null; then
        return 0
    fi
    # Check if "KEY=VALUE" exists and create or edit it
    if grep -q "^${key}=" "$envFileLocal" 2>/dev/null; then
        # Update if "KEY=VALUE" exists
        echo "$key exists in the "$envFileLocal" file. Modifying..."
        grep -v "^${key}=" "$envFileLocal" > "${envFileLocal}.tmp"
        echo "$entry" >> "${envFileLocal}.tmp"
        mv "${envFileLocal}.tmp" "$envFileLocal"
        return 0
    else
        # Append "KEY=VALUE" if it is missing
        [[ -s "$envFileLocal" && -n "$(tail -c 1 "$envFileLocal" 2>/dev/null)" ]] && echo "" >> "$envFileLocal"
        echo "$entry" >> "$envFileLocal"
        return 0
    fi
}

## Secret Key
# - Checks if a secret key exists and randomly generate one if it doesn't
# - Tries in this order: openssl, od, python3, cksum
# - Nested conditional make this annoying to extend, but it shouldn't need to be extended.

ensureSecretKey () {
    # Check if key exists and generate one if it doesn't
    touch "$envFile"
    if ! grep -q "^SEARXNG_SECRET=" "$envFile" 2>/dev/null; then
        echo "Generating secret key..."
        local secretKey
        # Generate the key
        # Try OpenSSL :
        if command -v openssl >/dev/null 2>&1; then
            secretKey=$(openssl rand -hex 32)
        # Try od (POSIX) :
        elif command -v od >/dev/null 2>&1; then
            secretKey=$(od -An -N32 -tx1 < /dev/urandom | tr -d '[:space:]')
        else
            # Try Python :
            if command -v python3 >/dev/null 2>&1; then
                secretKey=$(python3 -c 'import secrets; print(secrets.token_hex(32))' 2>/dev/null || true)
            fi
            # Fallback: cksum, not crypto secure :
            if [[ -z "$secretKey" ]]; then
                secretKey=$(head -c32 /dev/urandom | cksum | cut -d' ' -f1)
                echo "I couldn't generate a cryptographically secure Secret Key, so I fell back on a less secure alternative."
                echo "$appName should still work but consider manually generating a random 64 character hex string and manually editing the $envFile"
            fi
        fi
        # Append to .env:
        editEnv "SEARXNG_SECRET=$secretKey"
        return 0
    fi
}

## Setup :
# - Pass 1 after calling to prevent inbuilt auto-restart
# - Asks user to select which compose file to use.
# - Checks for or generates secret key with ensureSecretKey
# - Stack will restart automatically when you select or change a setup.

setupFunc () {
    echo "Please select your processor type."
    echo "System Architecture:"
    local dontRestart="${1:-0}"
    select opt in "${options[@]}"; do
        # Check that input is valid
        if [[ "$REPLY" =~ ^[0-9]+$ ]]; then
            if [[ "$REPLY" -le "${#options[@]}" ]] && [[ "$REPLY" -ge 1 ]]; then
                case "$opt" in
                    "Exit Setup")
                        echo "Exiting."
                        exit
                        ;;
                    *)
                        local index="$((REPLY-1))"
                        # Check menu choice is associated with a file name
                        if [[ -n "${fileNames[index]}" ]]; then
                            local selectedFile=${fileNames[index]}
                            echo "Selected: $REPLY: $opt ($selectedFile)"
                            # Check file is present
                            if [[ ! -f $selectedFile ]]; then
                                echo "ERROR: Compose file $selectedFile not found" >&2
                                errExit 2
                            fi

                            # Create or Update .env
                            editEnv "COMPOSE_FILE=$selectedFile"
                            ensureSecretKey
                            echo "Configuration saved to "$envFile"."

                            # Check if previously run / need to restart
                            if [[ $dontRestart -eq 0 ]] && grep -q "^PREVIOUSLY_RUN=true" "$envFile" 2>/dev/null; then
                                echo "Previous run detected: automatically restarting..."
                                startCheck
                            fi
                            break
                        else
                            echo "Invalid selection" >&2
                        fi
                esac
            else
                echo "Invalid Selection: $REPLY" >&2
                echo "Try again. Enter a number between 1 and ${#options[@]}"
            fi
        else
            echo "Invalid Selection: $REPLY" >&2
            echo "Try again. Enter a number between 1 and ${#options[@]}"
        fi
    done
}

## Start :
# - Checks for valid configuration by checking the .env
# - Repairs broken/missing .env files.
# - Checks for previous run for appropriate start/restart messaging.

startCheck () {
    echo "Checking configuration..."
    # Check if a compose file is defined, if not: setup, else start/restart
    if [[ ! -s "$envFile" ]] || ! grep -q "^COMPOSE_FILE=" "$envFile"; then
        echo "First time setup detected (or missing configuration)!" >&2
        setupFunc 1
    fi
    if grep -q "^PREVIOUSLY_RUN=true" "$envFile" 2>/dev/null; then
        echo "Valid configuration - Restarting!"
    else
        echo "Valid configuration - Starting for the first time, enjoy!"
        # Append to .env:
        if ! grep -q "^PREVIOUSLY_RUN=true" "$envFile" 2>/dev/null; then
            [[ -f "$envFile" && -n "$(tail -c 1 "$envFile" 2>/dev/null)" ]] && echo "" >> "$envFile"
            echo "PREVIOUSLY_RUN=true" >> "$envFile"
        fi
    fi
    docker compose up -d --force-recreate
    cat << EOF

           $appName Startup Complete!
              Version: $appVersion

Access the AI Chat interface at:      $webUiURL

Access the SearXNG search engine at:  $searxngBaseURL

Security Tip: For secure public access, edit $envFile:
    - Set SEARXNG_HOSTNAME=yourdomain.com
    - Set SEARXNG_TLS=letsencrypt  (your key)
    - Modify the envVars array in the $scriptName script so it doesn't overwrite your changes!
    - Then run $scriptName to restart, and enjoy!
EOF
    return 0
}

# Main
## Switch to script directory
cd "$scriptWorkingDir"

## Check command
case "$firstArg" in
    start|"")
        # Default
        echo "$appName Starting..."
        # Check for dependencies
        checkArray
        checkArray envVars
        # Start and run setup if needed
        startCheck
        ;;
    setup|-s|--setup)
        # Check for dependencies
        checkArray
        checkArray envVars
        # Run setup and then start
        setupFunc 0
        exit
        ;;
    help|-h|--help)
        printUsage "$@"
        ;;
    down|-d|--down)
        # Check for dependencies
        checkArray
        # Stop Stack
        echo "Stopping $appName..."
        docker compose down "$@"
        ;;
    logs|-l|--logs)
        # Check for dependencies
        checkArray
        # Show logs
        if [[ $# -eq 0 ]]; then
            echo "Showing last 100 logs:"
            docker compose logs --tail 100
        else
            echo "Running 'docker compose logs $@'"
            docker compose logs "$@"
        fi
        ;;
    download|-dl|--download)
        # Check for dependencies
        checkArray
        # Check that the ollama container is running
        if [[ -z "$(docker compose ps -q ollama 2>/dev/null)" ]]; then
            echo "ERROR: $appName isn't running. Please run $scriptName without arguments." >&2
            errExit 2
        fi
        # Download a model
        if [[ $1 ]]; then
            echo "Running docker exec ollama ollama run $@"
            docker exec ollama ollama run "$@"
            echo "$1 is ready to use!"
            exit
        else
            echo "Please enter an Ollama model code to download (i.e. llama3.2:1b)" >&2
            echo "Example: $scriptName download llama3.2:1b" >&2
            errExit 1
        fi
        ;;
    *)
        echo "ERROR: Unknown command: $firstArg" >&2
        printUsage
        errExit 1
        ;;
esac