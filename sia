### Check for or restore local config
LOCAL_CONFIG="sia-config.sh"
TEMPLATE_CONFIG=".sia-config-template.sh"
# If config template is missing (e.g. user deleted everything but sia), recover it
if [[ ! -f "$scriptWorkingDir/.sia-config-template.sh" ]]; then
    echo "sia-config-template.sh missing - recovering from latest version..."
    curl -fsSL https://raw.githubusercontent.com/joshua-hvmn/SIA/main/.sia-config-template.sh -o "$scriptWorkingDir/sia-config.sh" || errExit 404
fi
# If first setup or missing local config, create
if [[ ! -f "$LOCAL_CONFIG" ]]; then
    if [[ -f "$TEMPLATE_CONFIG" ]]; then
        echo "Creating local config from template..."
        cp "$TEMPLATE_CONFIG" "$LOCAL_CONFIG"
        chmod 600 "$LOCAL_CONFIG"  # protect potential secrets
    else
        echo "ERROR: Template $TEMPLATE_CONFIG not found!"
        errExit 2
    fi
fi
source "$LOCAL_CONFIG"

### Consume first argument to be used for commands and shift so subfunctions can use subsequent arguments.
firstArg="${1:-start}"
