#!/bin/sh

set -eu

# VARIABLES
## Standards (change to change across script and .env file)
searxng_base_url="https://localhost/"
open_webui_url="http://localhost:3000/"
env_file=".env" # Change if you want to use a different .env file name.
fallback_app_version="v2.1.0+ (?)"
verbosity=2
term_width_fallback=75
term_max_width=85
script_name="./$(basename "$0")"
app_name=$(basename "$0" | tr '[:lower:]' '[:upper:]')

### Set app name and version number (Rename this script as you please, it should still work, but note that the app_name is automatically made uppercase based on script name).
if [ -d .git ]; then
    app_version="$(git describe --tags $(git rev-list --tags --max-count=1) 2>/dev/null || printf '%s' "$fallback_app_version")"
else
    app_version="$fallback_app_version"
fi

## Where the main script lives
#  - Note: will have to change SIA_HOME_DIR if you move the main script into bin/
# SIA_HOME_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
script_path=$(
    CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P
)/$(basename -- "$0")
SIA_HOME_DIR=$(dirname "$script_path")

# To make sure only main script loaded
export SIA_MAIN_LOADED=true

export SIA_HOME_DIR

### If verbosity defined: set it
case "${1:-}" in
    --silent|0)
        verbosity=0
        shift
        ;;
    --quiet|1)
        verbosity=1
        shift
        ;;
    2)
        shift
        ;;
    --debug|--verbose|3|--loud)
        verbosity=3
        shift
        ;;
esac

### Consume first argument to be used for commands and shift so subfunctions can use subsequent arguments.
first_arg="${1:-start}"
shift || true

# MOCK FUNCTIONS FOR TESTING
#  - uncomment to block relevant commands during testing

#docker() {
#    printf '%s' "[MOCK] docker $@"
#}
#git() {
#    printf '%s' "[MOCK] git $@"
#}

## Detect outdated Docker Compose and change commands if necessary

if ! docker compose version >/dev/null 2>&1 && command -v docker-compose >/dev/null 2>&1; then
    docker() { if [ "$1" = "compose" ]; then shift; command docker-compose "$@"; else command docker "$@"; fi; }
fi

# Relative Paths
DEFAULTS="$SIA_HOME_DIR/share/env_defaults"
DEPENDENCIES="$SIA_HOME_DIR/share/dependencies"
# PROVIDERS="$SIA_HOME_DIR/share/providers"

# Source subscripts
. "$SIA_HOME_DIR/lib/ui.sh"
. "$SIA_HOME_DIR/lib/core.sh"
. "$SIA_HOME_DIR/lib/env_logic.sh"

# Main
## Switch to script directory
cd "$SIA_HOME_DIR"

## Make sure env exists
create_env_from_template

## Make sure launched main script, check command
case "$first_arg" in
    start|"")
        # Default
        msg_info "$app_name validating configuration..."
        # Check for all dependencies
        checkDeps
        # Start and run setup if needed
        startCheck
        ;;
    setup|-s|--setup)
        # Check for all dependencies
        checkDeps
        # Run setup and then start
        change_setup 1
        exitScriptGoodWithMessage
        ;;
    help|-h|--help)
        printUsage "$@"
        ;;
    down|-d|--down)
        checkDeps
        # Stop Stack
        msg_header "Stopping $app_name..."
        docker compose down "$@"
        ;;
    logs|-l|--logs)
        # Check for hard dependencies
        checkDeps
        # Show logs
        if [ $# -eq 0 ]; then
            msg_info "Showing last 100 logs:"
            docker compose logs --tail 100
        else
            msg_info "Running 'docker compose logs $@'"
            docker compose logs "$@"
        fi
        ;;
    download|-dl|--download)
        # NOTE: command injection risk, fix by assigning model=$1, and shift, then args as $@
        # Check for hard dependencies 
        checkDeps
        # Check that the ollama container is running
        if [ -z "$(docker compose ps -q ollama 2>/dev/null)" ]; then
            msg_error "$app_name isn't running. Please run $script_name without arguments."
            errExit 2
        fi
        # Download a model
        if [ $1 ]; then
            msg_debug "Running docker exec ollama ollama run $@"
            docker exec ollama ollama run "$@"
            exitScriptGoodWithMessage "$1 is ready to use!"
        else
            msg_error "Please enter an Ollama model code to download (i.e. llama3.2:1b)"
            msg_usage "'$script_name download llama3.2:1b' (or whatever model you want)"
            errExit 1
        fi
        ;;
    env|environment|-env|--environment)
        # Check for args
        envCommand "$@"
        ;;
    *)
        msg_error "Unknown command: $first_arg"
        printUsage
        errExit 1
        ;;
esac
# Note: Reserved first arguments for verbosity:
# - --silent / 0
# - --quiet / 1
# - 2 (default)
# - --debug / --verbose / 3 / --loud