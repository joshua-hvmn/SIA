#!/usr/bin/env bash

set -euo pipefail

# VARIABLES
## Standards (change to change across script and .env file)
searxngBaseURL="https://localhost/"
webUiURL="http://localhost:3000/"
envFile=".env" # Change if you want to use a different .env file name.

### Set app name and version number (Rename this script as you please, it should still work).
if [[ -d .git ]]; then
    appVersion="$(git describe --tags $(git rev-list --tags --max-count=1) 2>/dev/null || echo "v0.9.2+")"
else
    appVersion="v0.9.2+"
fi
scriptName="./$(basename "$0")"
appName=$(basename "$0" | tr '[:lower:]' '[:upper:]')
scriptWorkingDir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

### Consume first argument to be used for commands and shift so subfunctions can use subsequent arguments.
firstArg="${1:-start}"
shift || true

## Arrays
options=( # Must be ordered like fileNames with one extra "Exit Setup" option always at the end. Associative arrays are avoided for portability.
    "CPU Only"
    "Nvidia GPU"
    "AMD GPU"
    "Exit Setup"
)
fileNames=( # Must be ordered like options with no file to associate with the exit option in that array.
    ".compose.cpu.yaml"
    ".compose.nvidia.yaml"
    ".compose.amd.yaml"
)
dependencies=( # Simply add the command to be tested to this array.
    "docker"
    "git"
)
envVars=( # don't include the secret key or compose file variables, they are handled by other parts of the script. File constructed if necessary.
    "#   $appName  =  $appVersion"
    "#  For public access, change:"
    "#  - SEARXNG_HOSTNAME to your domain name"
    "#  - SEARXNG_TLS=letsencrypt  (your key)"
    "#  - Uncomment and set a LETSENCRYPT email in order to create a Let's Encrypt certificate"
    "#  TO CHANGE:" 
    "#  - $scriptName will overwrite any changes to the $envFile, except changing the Secret Key or selected COMPOSE_FILE"
    "#  - You must edit the envVars array in the $appName script instead of changing the $envFile file to make changes to anything in the array ($appName restores it on run)"
    "# LETSENCRYPT_EMAIL="
    "SEARXNG_HOSTNAME=localhost"
    "SEARXNG_TLS=internal"
    "SEARXNG_BASE_URL=$searxngBaseURL"
    "WEBUI_URL=$webUiURL"
    "OLLAMA_BASE_URL=http://ollama:11434"
    "WEB_SEARCH_ENGINE=searxng"
    "SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>&format=json"
    "SEARXNG_SECRET"
    "COMPOSE_FILE"
    "PREVIOUSLY_RUN"
)

