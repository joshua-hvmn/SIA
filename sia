#!/usr/bin/env bash

set -euo pipefail

# VARIABLES
## Standards (change to change across script and .env file)
searxngBaseURL="https://localhost/"
webUiURL="http://localhost:3000/"
envFile=".env" # Change if you want to use a different .env file name.
fallback_app_version="v2.1.0+ (?)"
verbosity=2
term_width_fallback=75
term_max_width=85
script_name="./$(basename "$0")"
app_name=$(basename "$0" | tr '[:lower:]' '[:upper:]')

### Set app name and version number (Rename this script as you please, it should still work, but note that the app_name is automatically made uppercase based on script name).
if [[ -d .git ]]; then
    app_version="$(git describe --tags $(git rev-list --tags --max-count=1) 2>/dev/null || echo "$fallback_app_version")"
else
    app_version="$fallback_app_version"
fi

## Where the main script lives
#  - Note: will have to change SIA_HOME_DIR if you move the main script into bin/
# SIA_HOME_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
script_path=$(readlink -f "$0")
SIA_HOME_DIR=$(dirname "$script_path")

# To make sure only main script loaded
export SIA_MAIN_LOADED=true

export SIA_HOME_DIR

# ## SUBSCRIPTS TO SOURCE 
# configScript="sia-config.sh"
# configTemplate=".sia-config-template.sh"
# messageScript=".sia-messages.sh"

### If verbosity defined: set it
case "${1:-}" in
    --silent|0)
        verbosity=0
        shift
        ;;
    --quiet|1)
        verbosity=1
        shift
        ;;
    2)
        shift
        ;;
    --debug|--verbose|3|--loud)
        verbosity=3
        shift
        ;;
esac

### Consume first argument to be used for commands and shift so subfunctions can use subsequent arguments.
firstArg="${1:-start}"
shift || true

