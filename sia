#!/bin/sh

set -eu

# VARIABLES
# Testing mode
# - set to 1 to mock docker and git commands
mock_test_mode=0

## Global Standards (change to change across script)
searxng_base_url="https://localhost/"   # Only affects messages, not env
open_webui_url="https://chat.localhost/" # Only affects messages, not env

# .env files
# - if you change these, you must change the associated mapping files in maps/
env_core_file="share/env/.env.core"
env_secrets_file="share/env/.env.secrets"
env_dynamic_file="share/env/.env.dynamic"
env_default_tune_llama_cpp_file="share/model-configs/llama-cpp-configs/base_llama_cpp_tune.env"
env_default_tune_ollama_file="share/model-configs/ollama-configs/base_ollama_tune.env"
compose_file=".compose.yaml"

fallback_app_version="v4.0.0"
verbosity=2 # default
term_width_fallback=90
term_max_width=95
script_name="./$(basename "$0")"
app_name=$(basename "$0" | tr '[:lower:]' '[:upper:]') # makes uppercase
systemOS="$(uname -s)"

## Git Repo standards
LINK="https://raw.githubusercontent.com"
USERNAME="joshua-hvmn"
REPOSITORY="SIA"
BRANCH="main"

# Setup changed and need restart (also using for changed environment)
chngst_sel_changed=0
SIA_NEEDS_CERT_INSTALL="false"

### Set app name and version number (Rename this script as you please, it should still work, but note that the app_name is automatically made uppercase based on script name).
if [ -d .git ]; then
    app_version="$(git describe --tags $(git rev-list --tags --max-count=1) 2>/dev/null || printf '%s' "$fallback_app_version")"
else
    app_version="$fallback_app_version"
fi

## Where the main script lives
#  - Note: will have to change SIA_HOME_DIR if you move the main script into bin/
# SIA_HOME_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
script_path=$(
    CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P
)/$(basename -- "$0")
SIA_HOME_DIR=$(dirname "$script_path")

# To make sure only main script loaded
export SIA_MAIN_LOADED=true

export SIA_HOME_DIR

### If verbosity defined: set it
case "${1:-}" in
    --silent|0)
        verbosity=0
        shift
        ;;
    --quiet|1)
        verbosity=1
        shift
        ;;
    2)
        shift
        ;;
    --debug|--verbose|3|--loud)
        verbosity=3
        shift
        ;;
esac

### Consume first argument to be used for commands and shift so subfunctions can use subsequent arguments.
first_arg="${1:-menu}"
shift || true

# MOCK FUNCTIONS FOR TESTING
#  - set the variable to 1 at the top (or here if you deleted it) to prevent
#    sensitive commands from running during testing

if [ "${mock_test_mode:-0}" -eq 1 ]; then
    docker() {
        printf '%s\n' "[MOCK] docker $*"
    }
    git() {
        printf '%s\n' "[MOCK] git $*"
    }
    curl() {
        printf '%s\n' "[MOCK] curl $*"
    }
fi

# Main
## Detect outdated Docker Compose and change commands if necessary

if ! docker compose version >/dev/null 2>&1 && command -v docker-compose >/dev/null 2>&1; then
    docker() { if [ "$1" = "compose" ]; then shift; command docker-compose "$@"; else command docker "$@"; fi; }
fi

## Relative Paths
DEFAULTS="$SIA_HOME_DIR/share/maps/env_filenames"
PROVIDERS="$SIA_HOME_DIR/share/maps/providers"
DEPENDENCIES="$SIA_HOME_DIR/share/lists/dependencies"
FILES="$SIA_HOME_DIR/share/lists/files"
SERVICE_PROFILES="$SIA_HOME_DIR/share/profiles/service_profiles"
LLM_RUNNER_PROFILES="$SIA_HOME_DIR/share/profiles/llm_runner_profiles"
HW_PROFILES="$SIA_HOME_DIR/share/profiles/hw_profiles"

## Source subscripts
. "$SIA_HOME_DIR/lib/ui.sh"
. "$SIA_HOME_DIR/lib/router.sh"
. "$SIA_HOME_DIR/lib/core.sh"
. "$SIA_HOME_DIR/lib/security.sh"
. "$SIA_HOME_DIR/lib/env_logic.sh"
. "$SIA_HOME_DIR/lib/messages.sh"
. "$SIA_HOME_DIR/lib/dependencies.sh"
. "$SIA_HOME_DIR/lib/update.sh"
. "$SIA_HOME_DIR/lib/caddy-ca-config.sh"
. "$SIA_HOME_DIR/lib/ollama_wrapper.sh"
. "$SIA_HOME_DIR/lib/llama_cpp_wrapper.sh"

## Switch to script directory
cd "$SIA_HOME_DIR"

## Route to subscripts

if [ "$first_arg" = "menu" ]; then
    main_menu
else
    process_commands "$@"
fi

# Note: Reserved first arguments for verbosity:
# - --silent / 0
# - --quiet / 1
# - 2 (default)
# - --debug / --verbose / 3 / --loud
