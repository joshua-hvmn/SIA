#!/usr/bin/env bash

set -euo pipefail

# VARIABLES
## Standards (change to change across script and .env file)
searxngBaseURL="https://localhost/"
webUiURL="http://localhost:3000/"
envFile=".env" # Change if you want to use a different .env file name.
fallbackAppVersion="v1.1.0+ (?)"

### Set app name and version number (Rename this script as you please, it should still work, but note that the appName is automatically made uppercase based on script name).
if [[ -d .git ]]; then
    appVersion="$(git describe --tags $(git rev-list --tags --max-count=1) 2>/dev/null || echo "$fallbackAppVersion")"
else
    appVersion="$fallbackAppVersion"
fi
