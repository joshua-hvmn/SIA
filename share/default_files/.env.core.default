# ---------------------------------------------------------
# SIA CORE INTERNAL STATE (Essential/managed by script, manual editing may cause errors)
# - edit with './sia setup' or reset env with './sia env'
# ---------------------------------------------------------
# Essential or used in compose file
SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>&format=json
COMPOSE_FILE=.compose.yaml
# Dynamic variables for state:
COMPOSE_PROFILES=
SETUP_COMPLETE=false
SIA_SERVICES=
SIA_HW_PROFILE=
SIA_LLM_RUNNER=
SIA_HF_ARGS=
SIA_LOCAL_MODEL=
