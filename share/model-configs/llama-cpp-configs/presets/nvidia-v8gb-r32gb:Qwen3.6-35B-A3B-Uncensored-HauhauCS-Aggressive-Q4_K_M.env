# SIA MODEL TUNE
# Name: nvidia-v8gb-r32gb:Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-Q4_K_M
# Author: joshua-hvmn
# Desc: Tune optimized for low VRAM environments, reduced GPU loading
#       and optimizations for token throughput from CPU loaded layers.
#       I get 9-20tps. Adjust N_GL to fit VRAM, and THREADS to match your CPU core count
# VRAM=8gb
# RAM=32gb
# WEIGHT=20.6gb
# TYPE=moe
LLAMACPP_CTX_SIZE=64000
LLAMACPP_N_GL=6
LLAMACPP_THREADS=8
LLAMACPP_PARALLEL=1
LLAMACPP_CACHE_K=q8_0
LLAMACPP_CACHE_V=q8_0
LLAMACPP_BATCH_SIZE=512
SIA_LLAMA_CPP_EXTRA_ARGS=
